 "knowledge": [
  {
   "id": "k_dolmen",
   "text": "고인돌은 덮개돌 밑에 받침돌을 고인, 청동기시대의 대표적인 무덤이자 기념물이다.",
   "historical_status": "historical_fact",
   "source": "한국민족문화대백과사전 '고인돌' https://encykorea.aks.ac.kr/Article/E0003901",
   "source_date": "2026-09-27"
  },
  {
   "id": "k_bipa",
   "text": "비파형 동검은 청동기시대의 무기 혹은 제기로, 칼몸이 악기 비파를 닮았다. 칼몸과 손잡이를 따로 만들어 끼운 조립식이다.",
   "historical_status": "historical_fact",
   "source": "한국민족문화대백과사전 '비파형 동검' https://encykorea.aks.ac.kr/Article/E0025256",
   "source_date": "2026-09-27"
  },
  {
   "id": "k_myth",
   "text": "『삼국유사』는 곰과 호랑이가 환웅에게 사람이 되기를 빌었고, 쑥 한 줌과 마늘 20개를 먹으며 삼칠일을 견딘 곰이 여자(웅녀)가 되었다고 전한다.",
   "historical_status": "mythology",
   "source": "한국민족문화대백과사전 '웅녀' https://encykorea.aks.ac.kr/Article/E0040541",
   "source_date": "2026-09-27"
  },
  {
   "id": "k_dangun",
   "text": "『삼국유사』는 환웅과 웅녀 사이에서 난 단군왕검이 아사달에 도읍을 정했다고 전한다(건국 신화).",
   "historical_status": "mythology",
   "source": "한국민족문화대백과사전 '왕검' https://encykorea.aks.ac.kr/Article/E0039027",
   "source_date": "2026-09-27"
  },
  {
   "id": "k_jejeong",
   "text": "학계에서는 단군왕검을 제사장(단군)과 정치 우두머리(왕검)를 겸한 존재로 이해한다.",
   "historical_status": "historical_record",
   "source": "한국민족문화대백과사전 '왕검' https://encykorea.aks.ac.kr/Article/E0039027",
   "source_date": "2026-09-27"
  },
  {
   "id": "k_hongik",
   "text": "홍익인간(널리 인간을 이롭게 하라)은 단군신화에 나오는 고조선의 건국이념이다.",
   "historical_status": "mythology",
   "source": "한국민족문화대백과사전 '홍익인간' https://encykorea.aks.ac.kr/Article/E0064339",
   "source_date": "2026-09-27"
  },
  {
   "id": "k_8laws",
   "text": "고조선에는 8조의 법이 있었고, 『한서』 지리지에 그중 3조목(살인은 사형, 상해는 곡물로 배상, 절도는 노비로 삼되 속전으로 풀려남)이 전한다.",
   "historical_status": "historical_record",
   "source": "위키백과(한국어) '팔조지교' https://ko.wikipedia.org/wiki/팔조지교 (『한서』 지리지 인용)",
   "source_date": "2026-09-27"
  },
  {
   "id": "k_hunt_signal",
   "text": "매깃 사냥 부족은 매 깃털로 신호를 주고받는다.",
   "historical_status": "game_setting",
   "source": "게임 설정(창작)",
   "source_date": "2026-09-27"
  },
  {
   "id": "k_river",
   "text": "들녘 사람들: ‘강은 넓어지며 바다로 간다. 짠 바람이 부는 쪽이 강어귀다.’",
   "historical_status": "game_setting",
   "source": "게임 설정(창작)",
   "source_date": "2026-09-27"
  },
  {
   "id": "k_bronze_mix",
   "text": "불꽃 장인들은 붉은 구리에 흰빛 돌(주석)을 섞어 더 단단한 청동을 만든다.",
   "historical_status": "game_setting",
   "source": "게임 설정(창작)",
   "source_date": "2026-09-27"
  }
 ],
